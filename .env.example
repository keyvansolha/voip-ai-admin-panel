# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Encrypts stored secrets (Gemini key, service-account JSON, panel token) and
# signs session cookies. Changing it invalidates every stored secret and logs
# everyone out, so set it once and back it up with the data volume.
#
#   openssl rand -base64 48
APP_SECRET=

# ---------------------------------------------------------------------------
# First-run admin (optional)
# ---------------------------------------------------------------------------
# Leave ADMIN_PASSWORD empty to have a random one generated and printed to the
# log on first boot. Only used when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATA_DIR=./data
# DATABASE_PATH=./data/app.db
# RECORDINGS_DIR=./data/recordings

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Set to false on a replica that should serve the UI without processing jobs.
WORKER_ENABLED=true
# How many recordings may be analysed at once.
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Limits and tooling
# ---------------------------------------------------------------------------
# Largest recording the ingest endpoint will accept, in bytes (default 200 MB).
MAX_UPLOAD_BYTES=209715200
# Used to shrink WAVs before upload. Bundled in the Docker image.
FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------
# true when a TLS-terminating reverse proxy forwards plain HTTP to this app,
# so the session cookie is still marked Secure.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Everything else — Gemini credentials, panel URL and token, prompts, retention
# — is configured in the admin panel under Settings, not here.
# ---------------------------------------------------------------------------
